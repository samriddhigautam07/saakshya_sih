# Copy to .env for local use. Keep credentials blank and out of version control.
APP_ENV=development
DATABASE_URL=sqlite:///./verifywise.db
CORS_ORIGINS=https://saakshya-visiontech.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
JWT_SECRET_KEY=replace-with-your-own-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
DOCUMENT_STORAGE_DIR=~/.verifywise-ai/private_documents
MAX_DOCUMENT_SIZE_BYTES=10485760
MAX_EXTRACTED_TEXT_CHARS=2000000
PDF_MAX_PAGES=200
PDF_PROCESSING_TIMEOUT_SECONDS=60
OCR_MAX_PAGES=20
OCR_DPI=150
OCR_MIN_DIGITAL_CHARS=16
OCR_MAX_PAGE_PIXELS=12000000
OCR_PAGE_TIMEOUT_SECONDS=10
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=30
MAX_LLM_INPUT_CHARS=50000
